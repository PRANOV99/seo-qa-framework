{
  "name": "seo-qa-framework",
  "version": "0.5.0",
  "description": "Production-ready SEO QA automation framework using Playwright and TypeScript.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "playwright test",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "report": "playwright show-report",
    "install:browsers": "playwright install",
    "seo:run": "tsx src/cli/index.ts",
    "audit": "tsx src/cli/index.ts",
    "blog-audit": "tsx src/cli/blog-audit.ts",
    "compare": "tsx src/cli/compare.ts",
    "api:start": "node dist/api/server.js",
    "api:dev": "tsx watch api/server.ts",
    "migrate:history": "tsx api/scripts/migrate-history-to-postgres.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "seo",
    "qa",
    "automation",
    "playwright",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@playwright/test": "1.61.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.5.0",
    "fflate": "^0.8.3",
    "prettier": "^3.3.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "axe-core": "^4.12.1",
    "chrome-launcher": "^1.2.1",
    "commander": "^12.1.0",
    "cors": "^2.8.6",
    "csv-parse": "^5.5.0",
    "csv-stringify": "^6.8.0",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "lighthouse": "^13.4.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "playwright": "1.61.1",
    "read-excel-file": "^9.2.0",
    "uuid": "^14.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.0"
  }
}
