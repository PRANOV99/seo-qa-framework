# API Server
PORT=3001

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Directories (default to api/uploads and api/history relative to project root)
# UPLOAD_DIR=/tmp/seo-qa-uploads
# HISTORY_DIR=./api/history

# PostgreSQL connection string — required. Audit history (the History page)
# is persisted here instead of as JSON files on disk.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Playwright / audit settings
HEADLESS=true
LOG_LEVEL=info
BASE_URL=https://example.com
