# API Server
PORT=3001

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Directories (default to api/uploads and api/history relative to project root)
# UPLOAD_DIR=/tmp/seo-qa-uploads
# HISTORY_DIR=./api/history

# Playwright / audit settings
HEADLESS=true
LOG_LEVEL=info
BASE_URL=https://example.com
